{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?:|ve-dcg|gioi-thieu|he-sinh-thai|talent|studio|vision|entertainment|mat-than-ai|lumiqc|giai-phap|du-an|lien-he|thong-tin-du-lieu|he-sinh-thai/dcg-(?:talent|studio|vision|entertainment)|giai-phap/(?:dcg-growmatch|sang-tao-video-ai|mat-than-ai|lumiqc|noi-dung-giai-tri-ai)|du-an/(?:dcg-growmatch|mat-than-ai|lumiqc))/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/.*$",
      "dest": "/404.html",
      "status": 404
    }
  ]
}